# Secrets that supabase/config.toml's [remotes.prod] block reads via env().
# Copy to supabase/.env.prod.auth (ignored), fill in, then load into the shell
# before `config diff` / `config push`:
#   set -a; source supabase/.env.prod.auth; set +a

# Resend API key the Auth service sends sign-in codes with.
PROD_SMTP_PASS=

# Google OAuth client secret (same client as dev).
PROD_GOOGLE_SECRET=

# Apple client secret: the signed JWT generated from the .p8 key. It expires
# after at most six months, so prod and dev both need regenerating on schedule.
PROD_APPLE_SECRET=
