# Edge Function secrets for mahjhero-prod. Copy to supabase/.env.prod (ignored),
# fill in, then:
#   npx supabase secrets set --env-file supabase/.env.prod --project-ref <prod-ref>
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by
# the platform and must not be set here.

# Shared secret pg_net sends as x-drain-secret. Generate a fresh one for prod
# (openssl rand -hex 32) and put the same value in public.app_config.
DRAIN_SECRET=

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
# Same value dev uses, e.g. "MahjHero <noreply@mail.mahjhero.com>".
SMTP_FROM=

# Origin that notification and invite emails link to.
PUBLIC_APP_URL=https://app.mahjhero.com
