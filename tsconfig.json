{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets components/__tests__/DateField.test.tsx import
    // '../DateField.tsx' by its explicit extension -- the only way to reach
    // the native file rather than DateField.web.tsx, which
    // vitest.config.ts's `resolve.extensions` prefers for every
    // extensionless import (matching what the real web build ships). Valid
    // only alongside `noEmit` (already set by expo/tsconfig.base), which
    // this project already relies on -- Metro/Vite compile, not `tsc`.
    "allowImportingTsExtensions": true
  },
  // Overrides (does not merge with) expo/tsconfig.base's own `exclude`, so
  // its entries are repeated here verbatim. The one addition is smtp.ts:
  // Deno resolves its `https://deno.land/...` URL import at edge-function
  // deploy time, and no version of Node/tsc resolution understands a URL
  // as a module specifier. Everything else in supabase/functions/ is plain
  // TypeScript and stays covered by tsc like the rest of the project.
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "supabase/functions/deliver-notifications/smtp.ts"
  ]
}
