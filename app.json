{
  "expo": {
    "name": "MahjHero",
    "slug": "mahjhero",
    "scheme": "mahjhero",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mahjhero.client",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.mahjhero.client"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "MahjHero uses your photos to attach images to messages.",
          "cameraPermission": "MahjHero uses your camera to attach a photo to a message."
        }
      ]
    ]
  }
}
