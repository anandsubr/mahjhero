{
  "expo": {
    "name": "MahjHero",
    "slug": "mahjhero",
    "scheme": "mahjhero",
    "version": "0.2.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.mahjhero.client",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.mahjhero.client"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "MahjHero uses your photos to attach images to messages.",
          "cameraPermission": "MahjHero uses your camera to attach a photo to a message.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5eef1b49-fad5-45b5-9d3e-69591d1fbd83"
      }
    },
    "owner": "anandsubramanian"
  }
}
