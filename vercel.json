{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web && node scripts/inject-web-favicon.js",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/e/[token].ts": { "includeFiles": "dist/index.html" }
  },
  "rewrites": [
    { "source": "/e/:token", "destination": "/api/e/:token" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
